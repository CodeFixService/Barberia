# Cloudflare (Pages o Workers): encabezados de seguridad (A8) y caché. No editar en cada app: se copia de saas/nucleo/_headers con sincronizar.py.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(self), microphone=(self), geolocation=(self), payment=(self), usb=(), serial=(), bluetooth=(), hid=(), midi=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Content-Security-Policy: object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' blob: https://challenges.cloudflare.com https://cdn.jsdelivr.net; worker-src 'self' blob: https://cdn.jsdelivr.net
/sw.js
  Cache-Control: no-cache
/*.html
  Cache-Control: no-cache
/shared/*
  Cache-Control: no-cache
/js/*
  Cache-Control: no-cache
/version.json
  Cache-Control: no-store
